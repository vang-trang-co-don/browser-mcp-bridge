{
  "name": "browser-mcp-bridge",
  "version": "1.0.0",
  "description": "Authenticated browser session bridge for MCP agents using Anthropic official SDK",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "browser-mcp-bridge": "dist/index.js"
  },
  "scripts": {
    "build:server": "tsc",
    "build:extension": "esbuild extension/src/*.ts --outdir=extension/dist",
    "build": "npm run build:server && npm run build:extension",
    "start": "node dist/index.js",
    "dev": "tsc -w"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  }
}
